---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { localizePath } from '../i18n/paths';
import { htmlLang, publishedLocales, t, type Locale } from '../i18n/ui';
import { hasPlaceholderContent } from '../lib/content';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Locale-neutral path of this page. Omit for pages without a translated twin (the 404). */
  path?: string;
  /** Override <html lang>, e.g. for the bilingual 404. */
  lang?: string;
  /** Picture shown when the page is shared on social media (SPEC 7), with its alt text. */
  image?: { src: ImageMetadata; alt: string };
}

const { locale, title, description, path, lang = htmlLang[locale], image } = Astro.props;
const site = Astro.site!;
const noindex = await hasPlaceholderContent();
// 1200px wide is what Facebook, Threads and X recommend; JPEG because not every crawler reads WebP or AVIF.
const og = image && (await getImage({ src: image.src, width: 1200, format: 'jpeg' }));
const url = path === undefined ? undefined : new URL(localizePath(locale, path), site);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/cormorant-garamond.woff2" as="font" type="font/woff2" crossorigin />
    {
      path !== undefined && (
        <>
          <link rel="canonical" href={url} />
          {publishedLocales.length > 1 && (
            <>
              {publishedLocales.map((l) => (
                <link rel="alternate" hreflang={htmlLang[l]} href={new URL(localizePath(l, path), site)} />
              ))}
              <link rel="alternate" hreflang="x-default" href={new URL(localizePath('en', path), site)} />
            </>
          )}
        </>
      )
    }
    {
      og && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="Yunya Hsu" />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          {url && <meta property="og:url" content={url} />}
          <meta property="og:image" content={new URL(og.src, site)} />
          <meta property="og:image:width" content={String(og.attributes.width)} />
          <meta property="og:image:height" content={String(og.attributes.height)} />
          <meta property="og:image:alt" content={image.alt} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, 'skip')}</a>
    <Header locale={locale} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
