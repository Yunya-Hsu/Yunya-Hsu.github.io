---
import logo from '../assets/brand/logo.svg?raw';
import { localizePath } from '../i18n/paths';
import { htmlLang, locales, t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Locale-neutral path of the current page, used for the language switch. Omit to hide the switch. */
  path?: string;
}

const { locale, path } = Astro.props;
const home = localizePath(locale, '/');
const about = localizePath(locale, '/about/');
// "Work" is current on the wall and on single work pages; nothing is current on the 404 (SPEC 5.1).
const onWork = path !== undefined && (path === '/' || path.startsWith('/works/'));
const onAbout = path === '/about/';

// Short visible label; the accessible name is the full language name and must contain the visible text (WCAG 2.5.3).
const langLabels: Record<Locale, { short: string; name: string }> = {
  en: { short: 'EN', name: 'EN English' },
  zh: { short: '中', name: '中文' },
};
---

<header class="site-header">
  <a class="logo" href={home} aria-label="Yours, Yunya" set:html={logo} />
  <nav aria-label={t(locale, 'nav.label')}>
    <ul>
      <li><a href={home} aria-current={onWork ? 'page' : undefined}>{t(locale, 'nav.work')}</a></li>
      <li><a href={about} aria-current={onAbout ? 'page' : undefined}>{t(locale, 'nav.about')}</a></li>
    </ul>
    {
      path !== undefined && (
        <ul class="lang" aria-label={t(locale, 'lang.label')}>
          {locales.map((l) => (
            <li>
              <a
                href={localizePath(l, path)}
                lang={htmlLang[l]}
                hreflang={htmlLang[l]}
                aria-label={langLabels[l].name}
                aria-current={l === locale ? 'true' : undefined}
              >
                {langLabels[l].short}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </nav>
</header>

<style>
  /* SPEC 2.3–2.4, 5.1: logo centred as one block, nav centred beneath it. */
  .site-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding: 48px var(--gutter);
  }

  .logo {
    display: block;
  }

  .logo :global(svg) {
    display: block;
    height: 104px;
    width: auto;
  }

  @media (min-width: 600px) {
    .logo :global(svg) {
      height: 140px;
    }
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px 36px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  :global(:lang(zh-Hant)) nav {
    letter-spacing: 0.2em;
  }

  ul {
    display: flex;
    gap: 36px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Equal space above and below so text and icons share a centre line; the underline sits 6px below the text. */
  nav a {
    display: inline-block;
    padding-block: 6px;
    border-bottom: 1px solid transparent;
    color: var(--color-muted);
  }

  nav a:hover {
    text-decoration: none;
    color: var(--color-text);
  }

  nav a[aria-current='page'] {
    color: var(--color-text);
    border-color: var(--color-text);
  }

  .lang {
    gap: 0;
    letter-spacing: 0.1em;
  }

  .lang a[aria-current] {
    color: var(--color-text);
  }

  .lang li + li::before {
    content: '/';
    padding-inline: 0.5em;
    color: var(--color-muted);
  }
</style>
