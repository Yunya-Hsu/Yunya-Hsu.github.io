---
// A separate file (not inlined) so browsers download and cache it once for every page.
import logoUrl from '../assets/brand/logo.svg?url';
import { localizePath } from '../i18n/paths';
import { htmlLang, locales, t, type Locale } from '../i18n/ui';
import { wallCategory, wallPath } from '../lib/wall';
import { categories } from '../lib/works';

interface Props {
  locale: Locale;
  /** Locale-neutral path of the current page, used for the language switch. Omit to hide the switch. */
  path?: string;
}

const { locale, path } = Astro.props;
const home = localizePath(locale, '/');
const about = localizePath(locale, '/about/');
const currentCategory = path === undefined ? undefined : wallCategory(path);
// "Work" is current on every wall and on single work pages; nothing is current on the 404 (SPEC 5.1).
const onWork = currentCategory !== undefined || (path?.startsWith('/works/') ?? false);
const onAbout = path === '/about/';

// Short visible label; the accessible name is the full language name and must contain the visible text (WCAG 2.5.3).
const langLabels: Record<Locale, { short: string; name: string }> = {
  en: { short: 'EN', name: 'EN English' },
  zh: { short: '中', name: '中文' },
};
---

<header class="site-header">
  {
    path !== undefined && (
      <nav class="lang" aria-label={t(locale, 'lang.label')}>
        <ul>
          {locales.map((l) => (
            <li>
              <a
                href={localizePath(l, path)}
                lang={htmlLang[l]}
                hreflang={htmlLang[l]}
                aria-label={langLabels[l].name}
                aria-current={l === locale ? 'true' : undefined}
              >
                {langLabels[l].short}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
  <a class="logo" href={home}>
    <img src={logoUrl} alt="Yours, Yunya" width="163" height="105" />
  </a>
  <nav class="main" aria-label={t(locale, 'nav.label')}>
    <ul>
      {/* Not a link: Work always asks which category to open (SPEC 5.1). A native disclosure, so a click or tap
          opens it in every browser even without JS; the script adds hover. */}
      <li>
        <details class="work-menu">
          <summary class="nav-item" aria-current={onWork ? 'true' : undefined}>{t(locale, 'nav.work')}</summary>
          <div class="menu" id="work-menu">
            <ul>
              {categories.map((category) => (
                <li>
                  <a
                    href={localizePath(locale, wallPath(category))}
                    aria-current={category === currentCategory ? 'page' : undefined}
                  >
                    <span>{t(locale, `category.${category}`)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </details>
      </li>
      <li>
        <a class="nav-item" href={about} aria-current={onAbout ? 'page' : undefined}>{t(locale, 'nav.about')}</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.work-menu')!;
  const summary = menu.querySelector('summary')!;

  // With a mouse the menu follows the pointer: entering opens it, leaving closes it, and clicking Work keeps it
  // open instead of toggling it shut. Touch, pen and keyboard keep the native click-to-toggle.
  let lastPointer = '';
  summary.addEventListener('pointerdown', (event) => (lastPointer = event.pointerType));
  summary.addEventListener('click', (event) => {
    if (lastPointer === 'mouse' && menu.open) event.preventDefault();
    lastPointer = '';
  });
  menu.addEventListener('pointerenter', (event) => {
    if (event.pointerType === 'mouse') menu.open = true;
  });
  menu.addEventListener('pointerleave', (event) => {
    if (event.pointerType === 'mouse') menu.open = false;
  });

  menu.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !menu.open) return;
    menu.open = false;
    summary.focus();
  });

  // Close when focus or a tap moves anywhere outside the menu.
  menu.addEventListener('focusout', (event) => {
    if (!menu.contains(event.relatedTarget as Node | null)) menu.open = false;
  });
  document.addEventListener('click', (event) => {
    if (!menu.contains(event.target as Node)) menu.open = false;
  });
</script>

<style>
  /* SPEC 2.3–2.4, 5.1: logo centred as one block, nav centred beneath it, language switch in the top-right corner. */
  .site-header {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding: 48px var(--gutter);
  }

  .logo {
    display: block;
  }

  .logo img {
    display: block;
    height: 104px;
    width: auto;
  }

  @media (min-width: 600px) {
    .logo img {
      height: 140px;
    }
  }

  nav {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  :global(:lang(zh-Hant)) nav.main {
    letter-spacing: 0.2em;
  }

  ul {
    display: flex;
    gap: 36px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* SPEC 2.5: selected = underline in the text colour; hover = white text on a dark patch, never an underline.
     Equal space above and below so text and icons share a centre line; the underline sits 6px below the text. */
  nav a,
  .nav-item {
    display: inline-block;
    padding-block: 6px;
    border: 0;
    border-bottom: 1px solid transparent;
    background: none;
    color: var(--color-muted);
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    /* Never the site-wide hover underline: in the header an underline only means "selected" (SPEC 2.5). */
    text-decoration: none;
    cursor: pointer;
    border-radius: 2px;
    transition:
      color 0.15s,
      background-color 0.15s,
      box-shadow 0.15s;
  }

  /* The side shadows widen the patch 6px past the text without moving anything; it stays inside the item's own
     height, so it never covers a neighbour's underline. The selected item is where you already are, so it stays still
     (Work's hover already opens its menu). */
  nav a:not([aria-current]):hover,
  .nav-item:not([aria-current]):hover {
    color: var(--color-hover-text);
    background-color: var(--color-hover-bg);
    box-shadow:
      -6px 0 0 var(--color-hover-bg),
      6px 0 0 var(--color-hover-bg);
  }

  nav a[aria-current],
  .nav-item[aria-current] {
    color: var(--color-text);
    border-color: var(--color-text);
  }

  /* The category menu hangs under Work, over the page, without moving anything (SPEC 5.1). */
  .work-menu {
    position: relative;
  }

  /* Work is a <summary>; drop the disclosure triangle (Safari draws it with its own pseudo-element). */
  summary {
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* <details> shows and hides the menu itself. */
  .menu {
    position: absolute;
    top: 100%;
    left: 50%;
    z-index: 10;
    translate: -50% 0;
    /* Transparent bridge from Work to the panel, so the pointer never leaves the hover area on the way down. */
    padding-top: 10px;
    text-transform: none;
    letter-spacing: normal;
    font-weight: 400;
  }

  /* Rows run edge to edge, so every hover patch is the full width of the menu. */
  .menu ul {
    flex-direction: column;
    gap: 0;
    padding-block: 8px;
    background: var(--color-bg);
    box-shadow: var(--shadow-print);
    white-space: nowrap;
  }

  .menu a {
    display: block;
    padding: 6px 28px 4px;
    border-bottom: 0;
    text-align: center;
    font-size: 0.9375rem;
    font-style: italic;
  }

  .menu a:not([aria-current]):hover {
    box-shadow: none;
    border-radius: 0;
  }

  /* The selected underline stays the width of the text, 6px below it. */
  .menu a span {
    display: inline-block;
    padding-bottom: 6px;
    border-bottom: 1px solid transparent;
  }

  .menu a[aria-current] span {
    border-color: var(--color-text);
    transition: border-color 0.15s;
  }

  /* One highlight at a time: while another category is hovered, the selected underline steps aside. */
  .menu ul:has(a:not([aria-current]):hover) a[aria-current] span {
    border-color: transparent;
  }

  :global(:lang(zh-Hant)) .menu a {
    font-style: normal;
    letter-spacing: 0.1em;
  }

  /* Top edge level with the header's 48px padding; it scrolls away with the page. */
  .lang {
    position: absolute;
    top: 48px;
    right: var(--gutter);
    letter-spacing: 0.1em;
  }

  .lang ul {
    gap: 0;
  }

  /* Wide enough that the 6px hover patch never touches the slash. */
  .lang li + li::before {
    content: '/';
    padding-inline: 1.25em;
    color: var(--color-muted);
  }
</style>
