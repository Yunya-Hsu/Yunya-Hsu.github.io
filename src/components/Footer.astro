---
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <SocialLinks class="footer-social" />
  {/* The brand, as in the logo (SPEC 5.1). */}
  <p>© {year} Yours, Yunya</p>
</footer>

<style>
  /* SPEC 2.1, 5.1: a band in the dark frame's colour, the social icons over a small italic copyright, centred. */
  .site-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-top: 120px;
    padding: 32px var(--gutter);
    background: var(--color-chrome-bg);
    color: var(--color-chrome-muted);
    font-size: 0.875rem;
    font-style: italic;
  }

  p {
    margin: 0;
  }

  /* SPEC 5.1: from 1024px no band, just the copyright, quietly centred at the end of the page; the icons are in the
     sidebar then (Header.astro). */
  @media (min-width: 1024px) {
    .site-footer {
      padding-bottom: 48px;
      background: none;
      color: var(--color-muted);
    }

    .site-footer :global(.footer-social) {
      display: none;
    }
  }
</style>
