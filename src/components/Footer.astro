---
import instagram from '../assets/icons/instagram.svg?raw';
import threads from '../assets/icons/threads.svg?raw';
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
const social = [
  { name: 'Instagram', href: 'https://www.instagram.com/yours_yunya/', icon: instagram },
  { name: 'Threads', href: 'https://www.threads.com/@yours_yunya', icon: threads },
];
---

<footer class="site-footer">
  <p>© {year} {t(locale, 'site.name')}</p>
  <ul>
    {
      social.map((s) => (
        <li>
          <a href={s.href} rel="me" aria-label={s.name} set:html={s.icon} />
        </li>
      ))
    }
  </ul>
</footer>

<style>
  /* SPEC 2.1, 5.1: warm grey band, centred small italic copyright, social links as icons. */
  .site-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-top: 120px;
    padding: 32px var(--gutter);
    background: var(--color-footer-bg);
    color: var(--color-footer-text);
    font-size: 0.875rem;
    font-style: italic;
  }

  p {
    margin: 0;
  }

  ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 16px glyph inside a 32px target. Icon-only links have no text to underline, so they fade on hover. */
  a {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    transition: opacity 0.2s;
  }

  a:hover {
    opacity: 0.55;
  }

  a :global(svg) {
    width: 16px;
    height: 16px;
  }
</style>
