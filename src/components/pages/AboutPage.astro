---
import { Image } from 'astro:assets';
import { bio } from '../../i18n/about';
import { t, type Locale } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAvatar } from '../../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const avatar = getAvatar();
---

<BaseLayout locale={locale} title={t(locale, 'meta.about.title')} description={t(locale, 'meta.description')} path="/about/">
  <article class="about">
    {
      avatar ? (
        <Image src={avatar} alt="" widths={[240, 480]} sizes="240px" class="avatar" />
      ) : (
        <div class="avatar placeholder" aria-hidden="true" />
      )
    }
    <h1 class="sr-only">{t(locale, 'about.title')}</h1>
    {bio[locale].map((paragraph) => <p>{paragraph}</p>)}
  </article>
</BaseLayout>

<style>
  .about {
    max-width: 36rem;
    margin-inline: auto;
    padding-block: 2rem;
  }

  .avatar {
    width: 240px;
    height: 240px;
    max-width: 60vw;
    max-height: 60vw;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 2rem;
  }

  .placeholder {
    background: var(--color-placeholder);
  }
</style>
