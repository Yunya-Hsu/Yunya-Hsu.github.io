---
import { Image } from 'astro:assets';
import { localizePath } from '../../i18n/paths';
import { t, type Locale } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWorks } from '../../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const works = await getWorks();
// Roughly the first screen on desktop; everything after it lazy-loads.
const EAGER_COUNT = 4;
---

<BaseLayout locale={locale} title={t(locale, 'meta.home.title')} description={t(locale, 'meta.description')} path="/">
  <h1 class="sr-only">{t(locale, 'nav.work')}</h1>
  <ul class="wall">
    {
      works.map((work, i) => (
        <li>
          <a href={localizePath(locale, `/works/${work.slug}/`)}>
            <Image
              src={work.image}
              alt={work.alt[locale]}
              widths={[400, 800, 1200]}
              sizes="(min-width: 1024px) 25vw, (min-width: 600px) 50vw, 100vw"
              loading={i < EAGER_COUNT ? 'eager' : 'lazy'}
            />
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  /* Stage 2 skeleton grid; replaced by the 4:5 gallery grid (SPEC 5.2) in stage 4. */
  .wall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
