---
import { intro } from '../../i18n/contact';
import { t, type Locale } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { EMAIL_SUBJECT, formEndpoint } from '../../lib/contact';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = intro[locale];
// First name then last name, as in Yunya's example (SPEC 5.5).
const nameParts = [
  { name: 'first_name', label: t(locale, 'contact.firstName'), autocomplete: 'given-name' },
  { name: 'last_name', label: t(locale, 'contact.lastName'), autocomplete: 'family-name' },
] as const;
const required = t(locale, 'contact.required');
---

<BaseLayout
  locale={locale}
  title={t(locale, 'meta.contact.title')}
  description={t(locale, 'meta.description')}
  path="/contact/"
>
  <div class="contact">
    <section class="intro page-text">
      <h1 class="page-title">{t(locale, 'contact.title')}</h1>
      <p>{text.greeting}</p>
      <p>{text.lead}</p>
      <p class="open-to">{text.openToLabel}</p>
      <ul>{text.openTo.map((item) => <li>{item}</li>)}</ul>
      <p>{text.closing}</p>
    </section>

    {/* A plain HTML form posting straight to Formspree, so it sends without JavaScript too (SPEC 5.5). The script
        below sends it in the background instead and shows the result here. */}
    <div class="send">
      <form
        class="contact-form"
        action={formEndpoint()}
        method="POST"
        data-sending={t(locale, 'contact.sending')}
        data-sent={t(locale, 'contact.sent')}
        data-failed={t(locale, 'contact.failed')}
      >
        <div class="name-parts">
          {
            nameParts.map((part) => (
              <div class="field">
                <label for={`contact-${part.name}`}>
                  {part.label} <span class="required">{required}</span>
                </label>
                <input id={`contact-${part.name}`} name={part.name} type="text" autocomplete={part.autocomplete} required />
              </div>
            ))
          }
        </div>
        <div class="field">
          <label for="contact-email">
            {t(locale, 'contact.email')} <span class="required">{required}</span>
          </label>
          <input id="contact-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="contact-message">
            {t(locale, 'contact.message')} <span class="required">{required}</span>
          </label>
          <textarea id="contact-message" name="message" rows="6" required></textarea>
        </div>
        <input type="hidden" name="_subject" value={EMAIL_SUBJECT} />
        {/* Honeypot: people never see this field, bots fill it in, and Formspree drops what they send. No reCAPTCHA,
            which would load Google's tracking (SPEC 8). */}
        <div class="gotcha">
          <label for="contact-gotcha">Leave this empty</label>
          <input id="contact-gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
        </div>
        <button type="submit">{t(locale, 'contact.send')}</button>
      </form>
      <p class="result" role="status" tabindex="-1"></p>
    </div>
  </div>
</BaseLayout>

<script>
  // Send in the background so the result shows on this page, in its language. Without JavaScript the form posts
  // to Formspree as usual and Formspree shows its own confirmation page.
  const form = document.querySelector<HTMLFormElement>('.contact-form')!;
  const button = form.querySelector('button')!;
  const result = document.querySelector<HTMLElement>('.contact .result')!;
  const { sending, sent, failed } = form.dataset as { sending: string; sent: string; failed: string };

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const label = button.textContent;
    button.disabled = true;
    button.textContent = sending;
    result.textContent = '';
    result.classList.remove('failed');
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error(`Formspree answered ${response.status}`);
      // Sent: the thanks takes the form's place, and focus follows it so it is read out.
      form.reset();
      form.hidden = true;
      result.textContent = sent;
      result.focus();
    } catch {
      // Keep what they wrote, so they can try again.
      result.textContent = failed;
      result.classList.add('failed');
    } finally {
      button.disabled = false;
      button.textContent = label;
    }
  });
</script>

<style>
  /* SPEC 5.5: phones and tablets stack the text over the form; from 1024px the text is on the left and the form on
     the right, like the text and photo on the About page. */
  .contact {
    display: grid;
    gap: 56px;
    max-width: 36rem;
    margin-inline: auto;
  }

  .intro p,
  .intro ul {
    margin: 0 0 1em;
  }

  /* "I'm open to:" sits right on top of its list. */
  .intro .open-to {
    margin-bottom: 0.25em;
  }

  .intro ul {
    padding-left: 1.25em;
  }

  .intro li::marker {
    color: var(--color-muted);
  }

  .contact-form {
    display: grid;
    gap: 20px;
  }

  /* The class sets display, which would otherwise win over the hidden attribute. */
  .contact-form[hidden] {
    display: none;
  }

  .field {
    display: grid;
    gap: 6px;
  }

  label {
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
  }

  /* First and last name side by side, even on phones. */
  .name-parts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .required {
    color: var(--color-muted);
    font-size: 0.75rem;
    font-style: italic;
    letter-spacing: 0.06em;
  }

  /* Chinese has no true italic (SPEC 2.3). */
  :global(:lang(zh-Hant)) .required {
    font-style: normal;
  }

  input,
  textarea {
    width: 100%;
    padding: 6px 10px;
    border: 1px solid var(--color-field-border);
    border-radius: 0;
    background: var(--color-field-bg);
    color: var(--color-text);
    font: inherit;
    font-size: 0.9375rem;
  }

  textarea {
    resize: vertical;
  }

  input:focus-visible,
  textarea:focus-visible {
    outline-offset: 0;
  }

  .gotcha {
    display: none;
  }

  /* A dark block like the frame, in the nav's small capitals (SPEC 2.1, 2.3). */
  button {
    justify-self: start;
    padding: 11px 32px;
    border: 0;
    border-radius: 2px;
    background: var(--color-chrome-bg);
    color: var(--color-chrome-text);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.15s;
  }

  button:hover {
    background: var(--color-text);
  }

  button:disabled {
    cursor: progress;
  }

  .result {
    margin: 0;
    font-size: 0.9375rem;
    letter-spacing: 0.03em;
  }

  .result:empty {
    display: none;
  }

  .result:focus {
    outline: none;
  }

  .result.failed {
    margin-top: 20px;
  }

  @media (min-width: 1024px) {
    .contact {
      grid-template-columns: minmax(0, 4fr) minmax(0, 5fr);
      gap: 80px;
      max-width: 804px; /* the About page's width, so the title stays put between the two pages */
    }
  }
</style>
