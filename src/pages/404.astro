---
import { publishedLocales } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';

// GitHub Pages serves a single 404.html for every language, so once Chinese is published this page is bilingual.
const bilingual = publishedLocales.includes('zh');
---

<BaseLayout locale="en" title="Page not found — Yunya Hsu" description="This page doesn't exist.">
  <div class="not-found">
    <section>
      <h1 class="page-title">Page not found</h1>
      <p><a href="/">Back to the work</a></p>
    </section>
    {
      bilingual && (
        <section lang="zh-Hant">
          <h2 class="page-title">找不到這個頁面</h2>
          <p><a href="/zh/">回到作品牆</a></p>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  /* SPEC 5: centred, with the same extra room on top as Contact, since there is so little here. */
  .not-found {
    display: grid;
    gap: 72px;
    padding-top: 64px;
    text-align: center;
  }

  /* The indent balances the letter-spacing browsers add after the last letter, so the title sits on the same
     centre line as its rule. */
  .page-title {
    text-indent: 0.12em;
  }

  .page-title::after {
    margin-inline: auto;
  }

  p {
    margin: 0;
  }

  /* Like the work page's back link: secondary colour; hover is white on a dark patch, never an underline (SPEC 2.5). */
  a {
    padding-block: 2px;
    border-radius: 2px;
    color: var(--color-muted);
    font-size: 0.9375rem;
    font-style: italic;
    transition:
      color 0.15s,
      background-color 0.15s,
      box-shadow 0.15s;
  }

  /* Chinese has no true italic (SPEC 2.3). */
  :global(:lang(zh-Hant)) a {
    font-style: normal;
  }

  a:hover {
    color: var(--color-hover-text);
    background-color: var(--color-hover-bg);
    box-shadow:
      -6px 0 0 var(--color-hover-bg),
      6px 0 0 var(--color-hover-bg);
    text-decoration: none;
  }
</style>
